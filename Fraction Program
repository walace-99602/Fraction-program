
"Program to show greater mathmatical precision"

from fractions import Fraction

# Initialize as an exact fraction
number = Fraction(3, 1)
IteNumb = 500

for iterator in range(1, IteNumb):
  number = number / Fraction(3, 1)

for iterator in range(1, IteNumb):
  number = number * Fraction(3, 1)

print("Number is :", number)
# If you need it back as a standard float at the very end:
print("As float :", float(number))
